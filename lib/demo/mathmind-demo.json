": []}, "info": {"E-HT-01": {"misconception": "Tin rằng chỉ phân số mới là số hữu tỉ, còn số nguyên và số thập phân hữu hạn thì không"}, "E-HT-02": {"misconception": "Nhầm số đối với số nghịch đảo"}, "E-HT-03": {"misconception": "Khi biểu diễn số âm trên trục số vẫn đếm về phía phải điểm O"}, "E-TT-01": {"misconception": "So sánh hai số âm theo giá trị tuyệt đối: số nào \"lớn hơn\" khi bỏ dấu thì lớn hơn"}, "E-TT-02": {"misconception": "So sánh hai phân số bằng cách so tử với tử và mẫu với mẫu, không đưa về cùng mẫu"}, "E-CT-01": {"misconception": "Tin rằng cộng hai phân số là cộng tử với tử và mẫu với mẫu"}, "E-CT-02": {"misconception": "Quy đồng mẫu nhưng giữ nguyên tử số, quên nhân tử với cùng thừa số phụ"}, "E-CT-03": {"misconception": "Cộng hai số trái dấu thì cộng hai giá trị tuyệt đối rồi giữ dấu của số đứng trước"}, "E-DN-01": {"misconception": "Bỏ dấu ngoặc có dấu trừ đằng trước thì chỉ đổi dấu số hạng đầu tiên"}, "E-DN-02": {"misconception": "Đặt dấu ngoặc có dấu trừ đằng trước mà không đổi dấu các số hạng đưa vào ngoặc"}, "E-NC-01": {"misconception": "Chia hai phân số bằng cách nhân thẳng tử với tử, mẫu với mẫu, không nghịch đảo số chia"}, "E-NC-02": {"misconception": "Khi chia thì nghịch đảo cả hai phân số chứ không chỉ nghịch đảo số chia"}, "E-NC-03": {"misconception": "Rút gọn bằng cách gạch bỏ một số hạng của tổng ở tử và ở mẫu"}, "E-LT-01": {"misconception": "Tin rằng luỹ thừa cơ số âm luôn mang dấu âm, không xét số mũ chẵn hay lẻ"}, "E-LT-02": {"misconception": "Không phân biệt (−a)^n với −a^n, coi hai cách viết là một"}, "E-LT-03": {"misconception": "Khi nâng luỹ thừa một tích hoặc một thương thì chỉ nâng cho một thừa số"}, "E-LT-04": {"misconception": "Nhân hai luỹ thừa cùng cơ số thì nhân hai số mũ"}, "E-LT-05": {"misconception": "Chia hai luỹ thừa cùng cơ số thì chia hai số mũ"}, "E-LT-06": {"misconception": "Luỹ thừa của luỹ thừa thì cộng hai số mũ, do nhầm với quy tắc nhân"}, "E-TU-01": {"misconception": "Thực hiện các phép tính lần lượt từ trái sang phải, không ưu tiên luỹ thừa rồi nhân chia"}, "E-TU-02": {"misconception": "Trong biểu thức có ngoặc thì làm phần ngoài ngoặc trước cho gọn"}, "E-CV-01": {"misconception": "Chuyển một số hạng sang vế kia mà giữ nguyên dấu"}, "E-CV-02": {"misconception": "Áp dụng quy tắc chuyển vế cho một thừa số: chuyển thừa số sang vế kia bằng cách đổi dấu"}}, "_ghi_chu": "LỚP DEMO — 40 học sinh MÔ PHỎNG (dfle-engine mo-phong-v2), không phải dữ liệu thật. Dùng cho trang công khai /dung-thu."}